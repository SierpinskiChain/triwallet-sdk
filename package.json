{
  "name": "@sierpinskichain/triwallet-sdk",
  "version": "0.1.3",
  "description": "TriWallet client runtime SDK for request validation, approvals, permissions, session security, and vault operations",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/approval-queue.ts",
    "src/dapp-permissions.ts",
    "src/network-account-engine.ts",
    "src/security-pack.ts",
    "src/session-runtime.ts",
    "src/tx-decode-sim.ts",
    "src/wallet-request.ts",
    "src/wallet-vault.ts",
    "src/wallet-connect.ts",
    "README.md"
